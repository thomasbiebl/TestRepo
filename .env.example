# Ohne diese Werte läuft die App im Demo-Modus (Daten nur im Browser).
# Kopiere die Datei nach .env.local und trage die Werte aus Supabase ein
# (Project Settings -> API). Der anon-Schlüssel ist öffentlich und darf im Frontend stehen.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Optional: Buttons für die Anmeldung mit Google, Apple oder Facebook (erst im Supabase-Dashboard einschalten).
# VITE_OAUTH_PROVIDERS=google,apple
